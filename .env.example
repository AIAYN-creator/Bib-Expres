# API keys y configuracion sensible van aqui (nunca en el .env real commiteado).

# Email de contacto para el "polite pool" de OpenAlex/CrossRef (mejor rate limit).
CONTACT_EMAIL=

# API key gratuita de Semantic Scholar (opcional, mejora el rate limit del modo "similares").
SEMANTIC_SCHOLAR_API_KEY=

# Enlace de tu biblioteca para abrir papers como si estuvieras en el campus (opcional).
# Ver docs/acceso-institucional.md. Ejemplo: https://proxy.tu-uni.es/login?url=
LIBRARY_LINK_TEMPLATE=

# Editoriales que cubre tu institucion, separadas por ';' (opcional, se rellena desde la GUI).
SUBSCRIBED_PUBLISHERS=

# Idioma (es / en), tema (system / light / dark) y aviso al terminar (on / off) de la GUI. Los guarda la propia GUI.
UI_LANGUAGE=
UI_THEME=
UI_NOTIFY=
